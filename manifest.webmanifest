{
  "name": "Location Sketch Map Studio",
  "short_name": "Location Map",
  "description": "Kerala village-office style location sketch maps",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1a73e8",
  "lang": "ml",
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [".lsm.json", ".json"],
        "text/html": [".lsm.html", ".html"]
      },
      "icons": [
        {
          "src": "template_form.png",
          "sizes": "any"
        }
      ]
    }
  ]
}
